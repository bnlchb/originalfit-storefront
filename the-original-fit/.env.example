# ============================================================
# THE ORIGINAL FIT — example environment variables
# Copy to `.env` and fill with your own project values.
# ============================================================

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# For GitHub Actions deploys, set these same names as repository secrets
# (Settings → Secrets and variables → Actions): the deploy workflow
# regenerates src/js/env.js from them at build time — no .env needed in CI.
